{
  "name": "quanda-api",
  "version": "0.1.0",
  "private": true,
  "description": "Persistent anonymous identity, projects, events, and analytics for QUANDA.",
  "type": "commonjs",
  "engines": {
    "node": ">=20.20.2 <21"
  },
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "test": "node --test tests/*.test.js",
    "migrate": "node database/migrate.js",
    "migrate:status": "node database/status.js",
    "deployment:check": "node scripts/check-deployment-package.js",
